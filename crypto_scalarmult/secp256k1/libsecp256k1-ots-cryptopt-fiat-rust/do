#!/usr/bin/env bash
# create cryptopt-asms
sfile="$(dirname "${0}")/asm.S"
test -e "${sfile}" && rm "${sfile}"
count=${1:-1}

resdir=${RESULTS_PATH:-~/cryptopt/results}

# Direct paths to fiat-rust secp256k1 assembly files
mul_asm="${resdir}/fiat-rust/fiat_rust_secp256k1_dettman_mul/seed3823874498784910_ratio10849.asm"
square_asm="${resdir}/fiat-rust/fiat_rust_secp256k1_dettman_square/seed0001746537458781_ratio09812.asm"

# Convert and append mul - rename rust_fiat functions to fiat
if [ -f "${mul_asm}" ]; then
  ~/cryptopt/modules/scripts/convert/intel2att.sh --crypto-namespace "${mul_asm}" | \
    sed 's/rust_fiat_secp256k1_dettman_mul_CryptOpt/fiat_secp256k1_dettman_mul/g' >>"${sfile}"
else
  echo "Could not find mul assembly: ${mul_asm}"
  exit 1
fi

# Convert and append square - rename rust_fiat functions to fiat
if [ -f "${square_asm}" ]; then
  ~/cryptopt/modules/scripts/convert/intel2att.sh --crypto-namespace "${square_asm}" | \
    sed 's/rust_fiat_secp256k1_dettman_square_CryptOpt/fiat_secp256k1_dettman_square/g' >>"${sfile}"
else
  echo "Could not find square assembly: ${square_asm}"
  exit 1
fi
