#!/usr/bin/env bash
# create cryptopt-asms
sfile="$(dirname "${0}")/asm.S"
test -e "${sfile}" && rm "${sfile}"
count=${1:-1}

resdir=${RESULTS_PATH:-~/cryptopt/results}

# Direct paths to rust-ec secp256k1 assembly files
mul_asm="${resdir}/rust-ec/rust_ec_secp256k1_mul/seed0001744091596612_ratio10493.asm"
square_asm="${resdir}/rust-ec/rust_ec_secp256k1_square/seed0001746575048113_ratio08485.asm"

# Convert and append mul - rename rust_ec functions to fiat dettman
if [ -f "${mul_asm}" ]; then
  # First create a temporary file with the fixed label
  temp_file=$(mktemp)
  sed 's/rust_ec_secp256k1_mul_inner_CryptOpt:/rust_ec_secp256k1_mul_CryptOpt:/' "${mul_asm}" > "${temp_file}"
  
  # Convert and rename
  ~/cryptopt/modules/scripts/convert/intel2att.sh --crypto-namespace "${temp_file}" | \
    sed 's/rust_ec_secp256k1_mul_CryptOpt/fiat_secp256k1_dettman_mul/g' >>"${sfile}"
  
  rm -f "${temp_file}"
else
  echo "Could not find mul assembly: ${mul_asm}"
  exit 1
fi

# Convert and append square - rename rust_ec functions to fiat dettman
if [ -f "${square_asm}" ]; then
  ~/cryptopt/modules/scripts/convert/intel2att.sh --crypto-namespace "${square_asm}" | \
    sed 's/rust_ec_secp256k1_square_CryptOpt/fiat_secp256k1_dettman_square/g' >>"${sfile}"
else
  echo "Could not find square assembly: ${square_asm}"
  exit 1
fi
